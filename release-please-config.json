{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "d51845f834cf606b058d470e550a5e85f4f05f6e",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "spars-nlp",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "extra-files": [
        {
          "type": "toml",
          "path": "crates/spars/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "installer/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "bindings/node/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == 'spars-nlp' || @.name.value == 'spars-node' || @.name.value == 'spars-model')].version"
        },
        {
          "type": "toml",
          "path": "consumer/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == 'spars-nlp' || @.name.value == 'spars-node' || @.name.value == 'spars-model')].version"
        },
        {
          "type": "json",
          "path": "bindings/node/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "bindings/node/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "bindings/node/package-lock.json",
          "jsonpath": "$.packages[''].version"
        }
      ],
      "version-file": "version.txt",
      "initial-version": "0.1.0"
    }
  }
}
