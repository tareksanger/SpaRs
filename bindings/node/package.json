{
  "name": "@spars/node",
  "version": "0.2.0",
  "license": "MIT",
  "description": "Native SpaRs inference for Node.js",
  "main": "index.js",
  "types": "index.d.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "napi build --platform --release --no-const-enum -- --locked --offline",
    "postbuild": "node scripts/declarations.mts",
    "typecheck": "tsc --noEmit",
    "test": "node --expose-gc --test tests/*.test.mts"
  },
  "napi": {
    "binaryName": "spars-node",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-apple-darwin"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.5",
    "@types/node": "24.13.6",
    "typescript": "5.9.3"
  },
  "bin": {
    "spars": "bin/spars.mjs"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "units.d.ts",
    "*.node",
    "bin/*.mjs",
    "execution.cjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tareksanger/SpaRs.git",
    "directory": "bindings/node"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
